{
  "name": "routeless-backend",
  "version": "1.0.0",
  "type": "module",
  "description": "Backend API and deterministic simulation engine for Routeless: The Last Mile",
  "main": "dist/api/server.js",
  "scripts": {
    "dev": "tsx watch src/api/server.ts",
    "build": "tsc",
    "start": "node dist/api/server.js",
    "test": "vitest run",
    "sim": "tsx src/engine/cli.ts",
    "optimize": "tsx src/engine/cli-opt.ts"
  },
  "keywords": [
    "transportation",
    "simulation",
    "optimizer",
    "express"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "tsx": "^4.11.0",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0"
  }
}
